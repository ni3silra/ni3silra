{
  "name": "backend-developer-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend Developer Portfolio with comprehensive accessibility testing",
  "main": "index.html",
  "scripts": {
    "test": "node tests/accessibility/test-validation.js",
    "test:accessibility": "node tests/accessibility/run-tests.js",
    "test:wcag": "node tests/accessibility/run-tests.js --suite wcag",
    "test:keyboard": "node tests/accessibility/run-tests.js --suite keyboard",
    "test:screenreader": "node tests/accessibility/run-tests.js --suite screenreader",
    "serve": "python -m http.server 8000 || python3 -m http.server 8000"
  },
  "keywords": [
    "portfolio",
    "accessibility",
    "wcag",
    "a11y",
    "frontend",
    "testing"
  ],
  "author": "Backend Developer",
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {}
}